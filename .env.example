# Copy to .env.local (and add the same names in Vercel → Settings → Environment Variables)

# --- Accounts & cross-device sync (optional; see docs/ACCOUNTS.md) ---
# From Supabase → Project Settings → API keys. The anon/publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sign-in buttons to show (each must be enabled in Supabase): google, discord, apple, github, email
NEXT_PUBLIC_AUTH_PROVIDERS=google,email

# --- AI (optional) ---
# Enables the optional "Refine with Claude" pass. Everything else is rules-based and needs no AI.
ANTHROPIC_API_KEY=
# Set to 1 to hard-disable the AI pass even if a key is present (recommended on the public site).
DECKBIT_DISABLE_AI=

# --- Scraping (optional) ---
# Moxfield blocks generic scrapers; if they've issued you an API User-Agent, put it here.
MOXFIELD_USER_AGENT=
