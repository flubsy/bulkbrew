# Copy to .env.local

# Optional. Enables the "Refine with Claude" pass in the builder. Everything else (building,
# upgrading, EDHREC data, combos, power rating) is rules-based and needs no AI at all.
ANTHROPIC_API_KEY=

# Set to 1 to hard-disable the AI pass even if a key is present (e.g. when sharing with friends).
DECKBIT_DISABLE_AI=

# Optional. Moxfield blocks generic scrapers; if they have issued you an API User-Agent, put it here.
MOXFIELD_USER_AGENT=
